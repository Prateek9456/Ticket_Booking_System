PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
FRONTEND_URL=http://localhost:5173

# Email — booking confirmations, password reset OTP, cancellations
#
# Option 1 — Brevo (RECOMMENDED: free, no domain, sends to ANY user, works on Render free tier)
# 1. Sign up at https://www.brevo.com (free, 300 emails/day, no credit card)
# 2. Senders & IP → Senders → add your Gmail/personal email → click verification link in inbox
# 3. SMTP & API → API Keys → create a key
# BREVO_API_KEY=xkeysib-xxxxxxxx
# BREVO_FROM_EMAIL=your.email@gmail.com
# BREVO_FROM_NAME=Ticket Booking
#
# Option 2 — Resend (test mode only delivers to YOUR resend.com signup email unless you buy a domain)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Ticket Booking <onboarding@resend.dev>
#
# Option 3 — Gmail SMTP (local dev only; Render free tier blocks SMTP ports)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your-16-char-google-app-password
# SMTP_FROM=Ticket Booking <your.email@gmail.com>
