PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
FRONTEND_URL=http://localhost:5173

# Email — booking confirmation emails with QR tickets
#
# Render FREE tier blocks SMTP ports (587/465). Ethereal/Gmail SMTP will NOT work there.
# Use Resend (HTTPS) on Render free tier, or run SMTP locally / on paid Render.
#
# Option 1 — Resend (recommended for Render free tier)
# Sign up at https://resend.com, create an API key, verify your domain (or use onboarding@resend.dev for testing).
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Ticket Booking <onboarding@resend.dev>
#
# Option 2 — Ethereal (local dev only; does NOT deliver to real inboxes)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user
SMTP_PASS=your-ethereal-password
SMTP_FROM=Ticket Booking <noreply@ticketbooking.local>
